# Copy to .env next to manage.py. dev.py only needs SECRET_KEY; prod.py
# refuses to start without the values marked "required".

SECRET_KEY=""                      # required - a long random string

# ---- production only --------------------------------------------------------
ALLOWED_HOSTS=""                   # required, comma separated: crm.example.com
# CSRF_TRUSTED_ORIGINS=""          # default: https://<each allowed host>

POSTGRES_DB=""                     # required
POSTGRES_USER=""                   # required
POSTGRES_PASSWORD=""
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="prefer"          # "require" for a managed database
# POSTGRES_CONN_MAX_AGE="60"

# SECURE_SSL_REDIRECT="true"       # "false" if the proxy already redirects
# SECURE_HSTS_SECONDS="3600"       # raise to 31536000 once HTTPS is settled
# SECURE_HSTS_INCLUDE_SUBDOMAINS="false"
# LOG_LEVEL="INFO"               # for the app's own loggers

# ---- background jobs --------------------------------------------------------
# CELERY_BROKER_URL="redis://localhost:6379/0"   # required in production;
#                                                # unset = run jobs inline (dev)

# ---- mail intake ------------------------------------------------------------
# MAIL_SOURCE="folder"                 # or "imap"
# MAIL_FOLDER="/path/to/mail-inbox"     # folder source: inbox/ and sent/ inside
# MAIL_SYNC_INTERVAL_SECONDS="300"      # how often celery beat syncs
# IMAP_HOST="imap.example.com"
# IMAP_PORT="993"
# IMAP_SSL="true"
# IMAP_USER="hello@studio.hu"
# IMAP_PASSWORD=""                      # an app password, not the account password
# IMAP_INBOX="INBOX"
# IMAP_SENT="Sent"                      # Gmail: "[Gmail]/Sent Mail"

# ---- sending mail -----------------------------------------------------------
# Development default: emails are written to MAIL_OUTBOX as .eml files.
# MAIL_OUTBOX="/path/to/mail-outbox"
# Production (required there): SMTP of the studio's mailbox provider
# EMAIL_HOST="smtp.example.com"
# EMAIL_PORT="587"
# EMAIL_HOST_USER="hello@studio.hu"
# EMAIL_HOST_PASSWORD=""               # an app password
# EMAIL_USE_TLS="true"                 # port 587; use EMAIL_USE_SSL for 465

# ---- electronic signatures (see README) ------------------------------------
# SIGNING_PROVIDER="manual"
# DOCUMENSO_API_TOKEN=""
# DOCUMENSO_WEBHOOK_SECRET=""
